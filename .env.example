# 이 파일을 .env.local 로 복사한 뒤 실제 값을 채우세요. (.env.local 은 git에 올라가지 않습니다)
# Netlify 배포 시에는 Site settings → Environment variables 에 동일한 키로 등록해야 합니다.
# Vite 환경변수는 빌드 시점에 주입되므로, 값을 바꾸면 재배포가 필요합니다.

# ── 외부 연동: 카카오 채널 (유일한 외부 연동) ─────────────────────────
# "카카오 채널로 상담하기" 버튼의 이동 주소
# 미설정 시 카카오 관련 버튼이 렌더되지 않습니다 (깨진 링크 노출 방지)
VITE_KAKAO_CHANNEL_URL=

# ── 백엔드 API (현재 미배포) ──────────────────────────────────────────
# 고객 매칭 신청 저장, 가이드/사용자 관리에 사용
# 2026-09-02 기준 백엔드는 어디에도 배포돼 있지 않다. 비워두는 것이 정상이며,
# 비워두면 프론트는 API 호출을 아예 하지 않고 mockDb 로 동작한다.
# 로컬에서 backend/ 를 띄워 붙여볼 때만 채운다.
#   로컬 예시:  http://localhost:8000
VITE_API_URL=
